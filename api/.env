# Server
PORT=3000
API_SERVER_URL=http://localhost
ALLOW_ORIGIN=http://localhost:4200,http://127.0.0.1:4200


# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=d_100
DB_CONNECTION_LIMIT=10


# Default admin user
DEFAULT_ADMIN_NAME=Dev Admin
DEFAULT_ADMIN_EMAIL=admin@d100.in
DEFAULT_ADMIN_PHONE=1234567890
DEFAULT_ADMIN_PASSWORD=1234


# Redis
REDIS_URL=redis://localhost:6379


# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=d100admin
RABBITMQ_PASSWORD=d100_dev_password
RABBITMQ_VHOST=/


# Secrets
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=86400  #24 hours
JWT_SESSION_KEY_PREFIX=SESSION


# Storage
RAW_UPLOAD_PATH=E:\\Project\\D-100-Storage\\DATA\\RAW
INGEST_UPLOAD_PATH=E:\\Project\\D-100-Storage\\DATA\\INGEST
DOWNLOAD_TEMP_PATH=E:\\Project\\D-100-Storage\\DOWNLOAD


# Upload
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_ALLOWED_EXTENSIONS=.xlsx,.xls,.csv,.parquet
UPLOAD_SESSION_TTL_SECONDS=86400 #24 hours
UPLOAD_FILE_NAME=UploadedFile


# Python
PYTHON_EXECUTABLE=python
PYTHON_TIMEOUT_MS=60000


# Constants
DATASET_PROCESSING_TIMEOUT_MS=1800000
DATASET_PROCESSING_MAX_PARALLEL=5
AUTO_DELETION_TIME_IN_DAYS=30
TOP_N_ROW_DATASET_PREVIEW=1000
